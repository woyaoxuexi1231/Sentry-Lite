<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Library for in-process hostfxr load from Sentry-Lite.exe (not WinExe). -->
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Sentry-Lite-lhm</AssemblyName>
    <RootNamespace>SentryLite.LhmBridge</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Threading.AccessControl" Version="10.0.3" />
  </ItemGroup>

  <!-- Exclude probe entrypoint from the library; probe is a separate project. -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="ProbeProgram.cs" />
  </ItemGroup>

  <Target Name="PreferWinAccessControl" AfterTargets="Publish">
    <PropertyGroup>
      <_WinAc>$(PublishDir)runtimes\win\lib\net8.0\System.Threading.AccessControl.dll</_WinAc>
      <_OutAc>$(PublishDir)System.Threading.AccessControl.dll</_OutAc>
    </PropertyGroup>
    <Copy Condition="Exists('$(_WinAc)')"
          SourceFiles="$(_WinAc)"
          DestinationFiles="$(_OutAc)"
          SkipUnchangedFiles="false" />
  </Target>

</Project>
